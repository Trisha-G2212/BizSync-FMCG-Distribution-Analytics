# Copy this file to .env and adjust values for your machine.
# Never commit the real .env file.

POSTGRES_USER=bizsync_user
POSTGRES_PASSWORD=bizsync_pass
POSTGRES_DB=bizsync

# Used by the backend when running OUTSIDE docker-compose (e.g. `uvicorn` locally)
DATABASE_URL=postgresql://bizsync_user:bizsync_pass@localhost:5432/bizsync

JWT_SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Used by the frontend to know where the API lives
REACT_APP_API_URL=http://localhost:8000/api
